---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Hi, I’m Shreyas Bharadwaj.</h1>
				<p>
					I’m a builder at heart—someone who enjoys turning curiosity into code, ideas into products,
					and thoughtful stories into something worth reading.
				</p>
				<p>
					This space is where I share the work, the thinking, and the media that keeps me inspired.
					You can read more <a href="/about">about me</a> or explore the latest writing in the <a href="/blog">blog</a>.
				</p>
			</section>
			<section>
				<h2>What I care about</h2>
				<ul>
					<li>Technology and product thinking</li>
					<li>Creative problem-solving</li>
					<li>Good storytelling, whether it’s in code or cinema</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
